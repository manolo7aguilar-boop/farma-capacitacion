rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isSysAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myRole() == 'admin'; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myRole() in ['admin', 'gerente', 'supervisor', 'encargado']; }
    function bootPath() { return /databases/$(database)/documents/meta/bootstrap; }

    // Marca única: el primer usuario registrado se vuelve administrador del sistema.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.region == null
        && request.resource.data.get('sucursal', null) == null
        && (request.resource.data.role == 'colaborador'
            || (request.resource.data.role == 'admin'
                && !exists(bootPath())
                && getAfter(bootPath()).data.uid == request.auth.uid));
      // El usuario solo puede cambiar su nombre; solo el administrador cambia rol, región y sucursal.
      allow update: if isSysAdmin()
        || (signedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isSysAdmin();
    }

    // Regiones (máximo 3 en la app). Todos leen; solo el administrador del sistema escribe.
    match /regions/{regionId} {
      allow read: if signedIn();
      allow create, update: if isSysAdmin() && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if isSysAdmin();
    }

    match /progress/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
